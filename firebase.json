{
  "database": {
    "rules": "database.rules.json"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ],
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "riverpod-chat-7936e",
          "appId": "1:663189732861:android:dd27d29657f442be15ed94",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "riverpod-chat-7936e",
          "appId": "1:663189732861:ios:bc683d065eac90e915ed94",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "riverpod-chat-7936e",
          "configurations": {
            "android": "1:663189732861:android:dd27d29657f442be15ed94",
            "ios": "1:663189732861:ios:bc683d065eac90e915ed94"
          }
        }
      }
    }
  }
}
